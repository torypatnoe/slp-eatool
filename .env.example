# Template — copy to .env and fill in real values. .env is gitignored.
# Sandbox credentials from developer.intuit.com (Development keys, NOT Production).

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Sandbox company id, returned as the realmId query param on the OAuth redirect.
QBO_REALM_ID=

# sandbox | production — controls the API base URL. Never default to production.
QBO_ENVIRONMENT=sandbox

# Must exactly match a Redirect URI registered on the Intuit app.
QBO_REDIRECT_URI=http://localhost:8080/callback

# Where the rotating refresh token is cached between runs (gitignored).
QBO_TOKEN_STORE=.qbo/token.json
